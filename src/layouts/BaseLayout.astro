---
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import ConfirmDialog from '../components/ConfirmDialog.astro';
import type { PageKey } from '../lib/paths';
import { AUTH_URL } from '../lib/config';

interface Props {
  title: string;
  description: string;
  page: PageKey;
  /** App pages render the signed-in identity in the header. */
  app?: boolean;
  bodyClass?: string;
}

const { title, description, page, app = false, bodyClass } = Astro.props;

let authOrigin = '';
try {
  authOrigin = AUTH_URL ? new URL(AUTH_URL).origin : '';
} catch {
  authOrigin = '';
}

// Applied to production builds only: the dev server injects inline scripts.
const csp = [
  "default-src 'self'",
  "script-src 'self' 'wasm-unsafe-eval'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: https://avatars.githubusercontent.com",
  "font-src 'self'",
  `connect-src 'self' https://api.github.com https://huggingface.co${authOrigin ? ` ${authOrigin}` : ''}`,
  "object-src 'none'",
  "base-uri 'none'",
  "form-action 'none'",
].join('; ');
const fullTitle = page === 'home' ? title : `${title} | AuroFlow`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#17191c" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AuroFlow" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content="https://fox3000foxy.com/auroflow/og.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AuroFlow. Ephemeral compute. Persistent state." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://fox3000foxy.com/auroflow/og.png" />
    <meta name="twitter:image:alt" content="AuroFlow. Ephemeral compute. Persistent state." />

    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  </head>
  <body class={bodyClass} data-page={page}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Topbar page={page} app={app} />
    <slot />
    <Footer />
    <div class="toasts" id="toasts" aria-live="polite"></div>
    <ConfirmDialog />
  </body>
</html>
