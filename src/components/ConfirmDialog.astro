---
/** Shared confirmation dialog, driven by confirmDialog() in src/lib/ui.ts. */
---

<dialog class="dialog" id="confirm-dialog" aria-labelledby="confirm-title" aria-describedby="confirm-body">
  <form method="dialog">
    <div class="dialog__body">
      <h2 class="dialog__title" id="confirm-title" data-dialog-title></h2>
      <p class="dialog__text" id="confirm-body" data-dialog-body></p>
      <label class="field" data-dialog-field hidden>
        <span class="field__label">Type <code data-dialog-hint></code> to confirm</span>
        <input class="input input--mono" data-dialog-input autocomplete="off" spellcheck="false" />
      </label>
    </div>
    <div class="dialog__actions">
      <button class="btn" type="button" data-dialog-cancel>Cancel</button>
      <button class="btn btn--primary" type="submit" data-dialog-confirm>Confirm</button>
    </div>
  </form>
</dialog>
