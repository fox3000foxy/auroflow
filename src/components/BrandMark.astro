---
/** Window frame with a stacked layer: the Golden Image under session layers. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  <rect x="2.75" y="2.75" width="18.5" height="18.5" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>
  <path d="M2.75 8.25h18.5" stroke="currentColor" stroke-width="1.5"></path>
  <rect x="6.5" y="12" width="11" height="2" fill="currentColor"></rect>
  <rect x="6.5" y="15.5" width="11" height="2" fill="currentColor" opacity="0.55"></rect>
</svg>
