---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/paths';
import { ENGINE_URL, PANEL_URL, SPEC, AUTO_SHUTDOWN_MIN, WORKFLOW_TIMEOUT_MIN } from '../lib/config';
import '../styles/home.css';

// Reference values published in the engine README (System specifications,
// Disk optimization, Observed benchmarks). Kept verbatim; not measured here.
const specs = [
  ['Operating system', SPEC.os],
  ['Version and build', `${SPEC.version}, build ${SPEC.build}`],
  ['Architecture', 'x86-64, English (United States)'],
  ['Virtual disk', `${SPEC.virtualDisk} QCOW2, 64 KiB clusters`],
  ['Image file', '4.82 GiB, Zstandard compressed'],
  ['Firmware', 'UEFI (OVMF) with emulated TPM 2.0'],
  ['Machine', `QEMU/KVM, ${SPEC.machine}, host CPU passthrough`],
  ['Devices', 'VirtIO SCSI, VirtIO network, memory balloon'],
];

const benchmarks = [
  ['Golden Image preparation, cold cache', '52.79 s'],
  ['GitHub cache restoration', 'about 39 s'],
  ['Golden Image preparation after cache restore', '3.46 s'],
  ['First persistent layer backup', 'about 17 s'],
];

const lifecycle = [
  {
    title: 'Start',
    body: 'The panel dispatches windows-persistent.yml in your workspace repository. It refuses to launch a second run while one is active or queued.',
  },
  {
    title: 'Prepare the runner',
    body: 'A GitHub-hosted Ubuntu runner installs QEMU, OVMF and swtpm, checks that /dev/kvm is available, and connects to your Hugging Face dataset, creating it as private if needed.',
  },
  {
    title: 'Restore the Golden Image',
    body: 'The image is restored from the Actions cache, or downloaded in parallel parts from the engine release, then verified against its SHA-256 and with qemu-img check.',
  },
  {
    title: 'Rebuild the disk chain',
    body: 'Saved layers are downloaded and checked against their manifest. A new, empty writable overlay is created on top of the chain.',
  },
  {
    title: 'Boot and open the tunnel',
    body: 'Windows boots with its saved UEFI and TPM state. Once Remote Desktop answers, ngrok opens a TCP tunnel and the endpoint is written to session.json on the golden-control branch.',
  },
  {
    title: 'Work',
    body: `The panel shows the endpoint for the current run only. The session ends when you shut down Windows, request a shutdown from the panel, or after ${AUTO_SHUTDOWN_MIN} minutes.`,
  },
  {
    title: 'Save',
    body: 'After a confirmed clean QEMU and TPM stop, the overlay is compressed with Zstandard, compared against the original, checksummed and committed to the dataset with the UEFI and TPM state.',
  },
];

const steps = [
  {
    title: 'Prepare three accounts',
    body: 'A GitHub account, an ngrok account for its authtoken, and a Hugging Face account with a token that can create and write datasets.',
  },
  {
    title: 'Sign in',
    body: 'Open Settings and sign in with GitHub. You confirm a short code on github.com; no password is entered in the panel.',
  },
  {
    title: 'Create the workspace',
    body: 'Choose a repository name and its visibility. Saving creates it from the Golden template and stores both tokens as encrypted Actions secrets.',
  },
  {
    title: 'Secure Windows',
    body: 'The reference image has a passwordless account. Set a strong password in your first session before relying on the endpoint, especially with a public workspace.',
  },
  {
    title: 'Start and connect',
    body: 'Start the instance from the panel. When the status turns ON, copy the endpoint into your RDP client without the tcp:// prefix.',
  },
  {
    title: 'Shut down to save',
    body: 'Shut down from the Start menu or the panel, then wait until Saving finishes. Force stop cancels the run and discards the session.',
  },
];
---

<BaseLayout
  title="Windows Golden | Windows 10 on demand with persistent storage"
  description="On-demand Windows 10 IoT Enterprise LTSC 2021 virtual machines on GitHub Actions, reachable over RDP and persisted as QCOW2 layers on Hugging Face."
  page="home"
  bodyClass="home"
>
  <main id="main" tabindex="-1">
    <section class="hero">
      <div class="hero__inner">
        <p class="hero__kicker">Windows 10 IoT Enterprise LTSC 2021 on QEMU/KVM</p>
        <h1 class="hero__title">Windows that boots on a GitHub runner and keeps its disk between sessions.</h1>
        <div class="hero__foot">
          <p class="hero__lede">
            Windows Golden starts a prepared Windows image on GitHub Actions when you need it, connects you over Remote Desktop through ngrok, and saves what changed as a compressed QCOW2 layer in your own private Hugging Face dataset.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary btn--lg" href={href('/panel/')}>Open the panel</a>
            <a class="btn btn--lg" href={ENGINE_URL} target="_blank" rel="noopener noreferrer"><Icon name="github" /> VM engine</a>
          </div>
        </div>
      </div>
    </section>

    <section class="band band--diagram" aria-labelledby="architecture">
      <div class="band__inner">
        <header class="band__head">
          <h2 id="architecture">How the pieces connect</h2>
          <p>The panel never talks to the VM directly. It drives the workspace repository through the GitHub API, and the runner reports back through the same repository.</p>
        </header>
        <ArchitectureDiagram />
      </div>
    </section>

    <section class="band" aria-labelledby="what">
      <div class="band__inner band__inner--split">
        <header class="band__head">
          <h2 id="what">What runs</h2>
          <p>A debloated Windows 10 IoT Enterprise LTSC 2021 installation, prepared once as the Golden Image and published as a release of the engine repository.</p>
        </header>
        <div class="split">
          <div class="prose">
            <p>
              Each session runs on a fresh GitHub-hosted runner. QEMU is given every available processor and the free memory minus about 1 GiB. The reference run allocated 4 vCPUs and 13 GiB.
            </p>
            <p>
              The Golden Image is never written to. Your changes land in a writable overlay; at shutdown only that overlay is uploaded, so a session that changed little saves quickly. The engine README reports a 9.0 GiB installation reduced to 4.74 GiB allocated after ReTrim and Zstandard compression, with the full 64 GiB of virtual capacity kept.
            </p>
            <p class="prose__note">
              Figures on this page come from the engine README and its reference runs. Actual performance depends on the runner and your network.
            </p>
          </div>
          <dl class="spec">
            {specs.map(([k, v]) => (
              <>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="lifecycle">
      <div class="band__inner band__inner--split">
        <header class="band__head">
          <h2 id="lifecycle">Lifecycle of a session</h2>
          <p>One workflow run is one session. The panel derives the VM status from the step the run is executing.</p>
        </header>
        <ol class="timeline">
          {lifecycle.map((item, index) => (
            <li class="timeline__item">
              <span class="timeline__index" aria-hidden="true">{String(index + 1)}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="band" aria-labelledby="persistence">
      <div class="band__inner band__inner--split">
        <header class="band__head">
          <h2 id="persistence">Persistence in layers</h2>
          <p>Every saved session becomes one more read-only layer, backed by the one before it.</p>
        </header>
        <div class="split split--even">
          <div class="stack" aria-label="Disk chain, newest on top">
            <div class="stack__layer stack__layer--live">
              <span>Session overlay</span><span>writable, this run</span>
            </div>
            <div class="stack__layer"><span>Layer 3</span><span>layers/&lt;id&gt;/disk.qcow2</span></div>
            <div class="stack__layer"><span>Layer 2</span><span>layers/&lt;id&gt;/disk.qcow2</span></div>
            <div class="stack__layer"><span>Layer 1</span><span>layers/&lt;id&gt;/disk.qcow2</span></div>
            <div class="stack__layer stack__layer--base"><span>Golden Image</span><span>pinned in golden.env</span></div>
          </div>
          <div class="prose">
            <p>
              <code>latest.json</code> in the dataset lists the chain in order with a SHA-256 per layer, and records the checksum of the Golden Image it was built on. A restore stops if any checksum, backing file or the base image does not match.
            </p>
            <p>
              Each layer folder also holds the UEFI variables and TPM state, so Windows sees the same firmware and TPM on every runner. Uploads are committed against the dataset revision read at boot, and the dataset must be private or the engine refuses to read or write it.
            </p>
            <p>
              If Windows or QEMU does not stop cleanly, nothing is saved, to avoid publishing an inconsistent disk. Deleting the dataset from Settings resets the machine to the Golden Image.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="start">
      <div class="band__inner band__inner--split">
        <header class="band__head">
          <h2 id="start">Getting started</h2>
          <p>Everything is configured from the panel. The first boot also downloads and caches the Golden Image.</p>
        </header>
        <div>
          <ol class="steps">
            {steps.map((step, index) => (
              <li class="steps__item">
                <span class="steps__index" aria-hidden="true">{String(index + 1)}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))}
          </ol>
          <div class="cta">
            <div>
              <h3>Ready to set up a workspace?</h3>
              <p>Sign in with GitHub, then create the workspace from Settings.</p>
            </div>
            <div class="cta__actions">
              <a class="btn btn--primary btn--lg" href={href('/settings/')}>Go to settings</a>
              <a class="btn btn--lg" href={href('/panel/')}>Open the panel</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="security">
      <div class="band__inner band__inner--split">
        <header class="band__head">
          <h2 id="security">Security and limits</h2>
          <p>Read this before exposing a session.</p>
        </header>
        <div class="split split--even">
          <ul class="facts">
            <li><strong>Remote Desktop is not authenticated by ngrok.</strong> The ngrok token authorises the tunnel agent, not RDP clients. Anyone with the endpoint can reach the Windows login screen.</li>
            <li><strong>The reference account has no password.</strong> Set a strong password through a trusted connection before relying on any endpoint.</li>
            <li><strong>Public workspaces publish the endpoint.</strong> session.json and the workflow annotations are readable by anyone. Use a private repository when you can.</li>
            <li><strong>Force stop discards the session.</strong> Cancelling the run skips the save step.</li>
          </ul>
          <ul class="facts">
            <li><strong>Tokens stay out of the repository.</strong> They are sealed in the browser with the repository key and stored as Actions secrets. The GitHub token is kept in the browser tab by default, with optional persistent sign-in for up to seven days.</li>
            <li><strong>The OAuth scope is broad.</strong> Device Flow requests <code>repo</code> and <code>workflow</code>, which reach all your repositories. A dedicated GitHub account limits the impact.</li>
            <li><strong>Sessions are time limited.</strong> Runs stop after {WORKFLOW_TIMEOUT_MIN} minutes; the engine powers Windows down at {AUTO_SHUTDOWN_MIN} minutes to leave time for the save.</li>
            <li><strong>Licensing is yours.</strong> The reference install was activated with MAS, which is not a Windows license. Use runners according to GitHub's terms.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="numbers">
      <div class="band__inner band__inner--split">
        <header class="band__head">
          <h2 id="numbers">Reference timings</h2>
          <p>Observed in the reference runs documented by the engine README.</p>
        </header>
        <table class="figures">
          <tbody>
            {benchmarks.map(([k, v]) => (
              <tr>
                <th scope="row">{k}</th>
                <td>{v}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>

</BaseLayout>
