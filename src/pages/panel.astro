---
import { href } from '../lib/paths';
const destination = href('/dashboard/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={new URL(destination, Astro.site).href} />
    <title>Moved to Dashboard | AuroFlow</title>
  </head>
  <body>
    <p>This page has moved to <a href={destination}>AuroFlow Dashboard</a>.</p>
  </body>
</html>
